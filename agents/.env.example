# Claude credentials (read by the Anthropic SDK)
# ANTHROPIC_API_KEY=

# Data API (`finagent-data serve` in data/). Unset = in-memory store.
# FINAGENT_AGENTS_DATA_URL=http://127.0.0.1:8765
# FINAGENT_AGENTS_DATA_TOKEN=

# `serve`
# FINAGENT_AGENTS_API_PORT=8766
# FINAGENT_AGENTS_API_TOKEN=               # require `Authorization: Bearer <token>`

# FINAGENT_AGENTS_MAX_RUNS=4               # concurrent runs, all workflows
# FINAGENT_AGENTS_REQUESTS_PER_SECOND=5.0  # Claude request rate limit

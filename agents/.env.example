FINAGENT_LLM_PROVIDER=ollama        # anthropic | openai | ollama
FINAGENT_LLM_MODEL=llama3.1
# FINAGENT_LLM_BASE_URL=http://localhost:11434
FINAGENT_TICKERS=["AAPL","MSFT","NVDA"]
FINAGENT_SCHEDULE_CRON=0 22 * * 1-5
FINAGENT_SCHEDULE_TIMEZONE=UTC
FINAGENT_OUTPUT_DIR=./reports

# Provider credentials (read by the provider SDKs directly)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# FinAgentData HTTP API (unset = in-memory store)
# FINAGENT_AGENTS_DATA_URL=http://127.0.0.1:8765
# FINAGENT_AGENTS_DATA_TOKEN=
